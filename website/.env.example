# Copy to .env.local for `next dev`. NEXT_PUBLIC_* values are inlined at build
# time, so rebuild after changing them.

# Origin this site is served from (canonical URL, sitemap, robots, JSON-LD).
# No trailing slash. Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to load no analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
