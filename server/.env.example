# Copy this file to .env.production (the file the server loads by default),
# or point ENV_FILE at another path. Variables already set in the process
# environment take precedence over the file. Never commit the real file.

# Which dotenv file to load (default: .env.production). Set it in the process
# environment, not in the file itself.
# ENV_FILE=.env.development
# Deployment name used in telemetry and by mailforge (default: production).
# With ENV=production the server refuses to start unless JWT_SECRET,
# APIKEY_SIGNING_SECRET, BASE_URL, FRONTEND_URL and ALLOWED_ORIGINS are set.
ENV=development

# PostgreSQL (docker-compose.yaml starts one with these values)
DB_HOST=localhost
DB_PORT=5432
DB_USER=domain_connect
DB_PASSWORD=domainconnect
DB_NAME=dc

# RabbitMQ AMQP URL. Leave empty to send email synchronously.
RABITMQ=amqp://admin:secret@localhost:5672/

# Auth
JWT_SECRET=change-me-long-random-string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_HOURS=168
APIKEY_SIGNING_SECRET=change-me-long-random-string
WEBHOOK_SIGNING_SECRET=change-me-long-random-string
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# URLs of YOUR deployment. There is no hosted instance; every default is local.
# Public URL of this API (tracking pixels, Domain Connect discovery).
# Default: http://localhost:8000
BASE_URL=http://localhost:8000
# The dashboard's URL (dev server: http://localhost:5173). The API builds its
# email links from it: /verify, /reset-password (the dashboard serves those,
# plus /forgot-password), and the docs/support/privacy/terms footer links.
# Default: http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Dashboard web app ("Dashboard" links in email). Default: FRONTEND_URL
DASHBOARD_URL=
# CORS origins, comma separated. Exact origins; the /v1 API also accepts
# "*.example.com" (matches example.com and its subdomains). FRONTEND_URL and
# DASHBOARD_URL are always allowed by /v1.
ALLOWED_ORIGINS=http://localhost:5173
# Default: http://localhost:5000
MCP_SERVER_BASE_URL=http://localhost:5000
# Default: BASE_URL
OAUTH_ISSUER_URL=http://localhost:8000
OAUTH_ALLOWED_CALLBACK_URLS=

# Branding and identity
# Name shown in emails and OAuth pages. Default: Vnytros
PRODUCT_NAME=
# Contact address shown in emails. Default: SMTP_FROM_EMAIL
SUPPORT_EMAIL=
# Logo image (absolute URL you host) in transactional emails; omitted if empty.
EMAIL_LOGO_URL=
# Domain Connect provider domain, e.g. example.com. Enables
# /.well-known/domainconnect/<it>/custom-domain, served from
# ./templates/<it>.custom-domain.json. Empty = route disabled.
# Add your own template to templates/ and submit it upstream
# (see templates/README.md).
DC_PROVIDER_DOMAIN=

# Social login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_CALLBACK_URL=
GOOGLE_MCP_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_CALLBACK_URL=

# Outgoing system mail (verification, password reset) and the default
# mailforge sender. EMAIL_* are accepted as fallbacks for SMTP_*.
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_PASSWORD=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=
MAIL_SEND_CONCURRENCY=8

# Mailforge (mail platform mounted at /api)
SEND_BATCH_SIZE=50
# Campaign footer watermark. No image = no footer. Images must be hosted by you.
MAIL_WATERMARK_IMAGE_URL=
MAIL_WATERMARK_LINK_URL=
MAIL_WATERMARK_LABEL=
# Extra watermark images users may pick, comma separated.
MAIL_WATERMARK_ALLOWED_IMAGE_URLS=

# Observability
OTEL_ENDPOINT=off
OTEL_TRACES_SAMPLE_RATIO=1.0
METRICS_HOST=127.0.0.1
