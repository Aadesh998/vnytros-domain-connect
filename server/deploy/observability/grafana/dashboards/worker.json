      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(vnytros_jobs_total{outcome!=\"ack\"}[5m])) / clamp_min(sum by (queue) (rate(vnytros_jobs_total[5m])), 0.001)",
