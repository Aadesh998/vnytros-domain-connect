# Copy to ~/deploy/.env on the server (Docker Compose reads it automatically for
# docker-compose.infra.yaml). Never commit the real file.

# RabbitMQ. Must match the user/password inside RABITMQ in the app's env file.
RABBITMQ_DEFAULT_USER=vnytros
RABBITMQ_DEFAULT_PASS=change-me-long-random-string

# Grafana admin login and the URL it is served at.
GRAFANA_ADMIN_PASSWORD=change-me-long-random-string
GRAFANA_ROOT_URL=https://grafana.example.com
