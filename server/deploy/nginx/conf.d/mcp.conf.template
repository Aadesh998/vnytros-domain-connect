# Template: rendered by deploy/scripts/nginx-install.sh with
#   envsubst '${DOMAIN}' < mcp.conf.template > /etc/nginx/conf.d/mcp.conf
# Only ${DOMAIN} is substituted; nginx's own $variables are left alone.
server {
    listen 80;
    listen [::]:80;
    server_name mcp.${DOMAIN};

    client_max_body_size 8m;

    access_log /var/log/nginx/mcp.access.log;
    error_log  /var/log/nginx/mcp.error.log;

    location / {
        proxy_pass http://vnytros_mcp;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_connect_timeout 10s;
        # The MCP handler streams; buffering makes a long tool call look hung.
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
