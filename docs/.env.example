# Copy to .env.local for `next dev`. NEXT_PUBLIC_* values are inlined at build
# time, so rebuild after changing them. Both are optional.

# Origin this docs site is served from (canonical URLs, sitemap, robots,
# JSON-LD). No trailing slash.
NEXT_PUBLIC_DOCS_URL=http://localhost:3001

# Origin of the project landing page (website/), referenced from JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
