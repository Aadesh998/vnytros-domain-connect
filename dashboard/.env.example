# Copy to .env.local (dev) or .env.production.local (build) and set your own
# values. Vnytros is self-hosted: there is no hosted API to fall back to.

# Required. Base URL of your Vnytros API (server/ in the monorepo), no trailing slash.
# `npm run build` fails if this is unset.
VITE_API_BASE_URL=http://localhost:8000

# Optional. Base URL for the mail endpoints (/api/*). Mail is served by the
# same API, so leave it empty to reuse VITE_API_BASE_URL.
VITE_MAILFORGE_BASE_URL=
